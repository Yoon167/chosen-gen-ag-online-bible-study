rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Gideon national admin (yoonhuaa@gmail.com). Must match NATIONAL_ADMIN_UID in lib/church.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "KcHm9yKcLcNbkTh7qbqi5pI7AYH2";
    }

    // The original teacher account from manage-topics.html; it may still edit topics.
    function isLegacyTeacher() {
      return request.auth != null
        && request.auth.uid == "1G2TVkbe9igM8ij5KN9SqIYo08M2";
    }

    // Legacy single-church "leader" profiles. Church roles now live in
    // churches/{churchId}/members; this only keeps existing legacy leaders'
    // access to teaching topics, and nobody can be promoted to it any more.
    function isLeader() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'leader';
    }

    match /topics/{topicId} {
      allow read: if true;
      // Writes are limited to the authorized teacher account and GIDEON leaders.
      // Saved topic documents may include slide notes, recap fields, testimony, notes, and public comments.
      // Leaders are either legacy "leader" profiles or cell leaders and up in
      // the first church, until topics move under churches/{churchId}.
      allow create, update, delete: if isAdmin() || isLegacyTeacher() || isLeader() || rankAtLeast('chosen-gen-ag', 3);
    }

    // GIDEON app: every member (including anonymous auth sessions) gets a
    // private subtree for their own prayers, notes, journey, Bible activity,
    // reading progress, and personal meeting links.
    match /users/{userId} {
      // Profiles are private: only the owner and the national admin (for
      // church setup) can read them. Leaders see their church roster instead.
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      // Members can't pick their own role: new profiles start as "member"...
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('role', 'member') == 'member';
      // ...and their own edits must leave the role untouched.
      allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.get('role', 'member') == resource.data.get('role', 'member');
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId
          && !(subcollection in ['assessments', 'vaultKeys']);
      }

      // Spiritual Assessment vault. Answers are encrypted on the member's
      // device; these rules only accept ciphertext, so a client bug can never
      // store plaintext. Guest (anonymous) sessions are refused because their
      // vault would be lost with the device.
      match /vaultKeys/{docId} {
        allow read, delete: if isVaultOwner(userId);
        allow create: if isVaultOwner(userId) && docId == 'main'
          && request.resource.data.keys().hasOnly(['v', 'pin', 'recovery', 'createdAt'])
          && request.resource.data.pin is map && request.resource.data.recovery is map;
        // A PIN reset re-wraps the key with a new PIN. The recovery copy must
        // stay the same, so an existing vault can never be replaced by a new one.
        allow update: if isVaultOwner(userId)
          && request.resource.data.recovery == resource.data.recovery
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly(['v', 'pin', 'recovery', 'createdAt', 'updatedAt']);
      }

      match /assessments/{docId} {
        allow read, delete: if isVaultOwner(userId);
        allow create: if isVaultOwner(userId)
          && request.resource.data.keys().hasOnly(['ct', 'iv', 'v', 'createdAt'])
          && request.resource.data.ct is string
          && request.resource.data.iv is string
          && request.resource.data.ct.size() < 200000;
        allow update: if false;
      }
    }

    // Signed in with Google or email, not a guest session. A guest who later
    // linked Google or email has identities on the token.
    function isRealAccount() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider != 'anonymous'
          || request.auth.token.firebase.get('identities', {}).size() > 0);
    }

    function isVaultOwner(userId) {
      return isRealAccount() && request.auth.uid == userId;
    }

    // ---------- Churches ----------
    // Roles live in churches/{churchId}/members/{uid} as a rank:
    // 1 member, 2 mentor, 3 cell leader, 4 ministry leader,
    // 5 associate pastor, 6 senior pastor. Must match lib/church.ts.

    function memberPath(churchId, uid) {
      return /databases/$(database)/documents/churches/$(churchId)/members/$(uid);
    }

    function isActiveMember(churchId, uid) {
      return exists(memberPath(churchId, uid))
        && get(memberPath(churchId, uid)).data.status == 'active';
    }

    function rankAtLeast(churchId, rank) {
      return request.auth != null
        && isActiveMember(churchId, request.auth.uid)
        && get(memberPath(churchId, request.auth.uid)).data.rank >= rank;
    }

    // A member their AG leader asked to present or exhort a Course lesson.
    function isAssignedPresenter(churchId, aid) {
      return request.auth != null && aid is string && aid != ''
        && isActiveMember(churchId, request.auth.uid)
        && exists(/databases/$(database)/documents/churches/$(churchId)/lessonAssignments/$(aid))
        && get(/databases/$(database)/documents/churches/$(churchId)/lessonAssignments/$(aid)).data.get('presenterUid', '') == request.auth.uid;
    }

    function myRank(churchId) {
      return get(memberPath(churchId, request.auth.uid)).data.rank;
    }

    // Senior pastor (6) is left out: only the national admin can appoint one.
    function validRole(role, rank) {
      return {'member': 1, 'mentor': 2, 'cell_leader': 3, 'ministry_leader': 4,
        'associate_pastor': 5}.get(role, 0) == rank;
    }

    // A member's own weekly check-in, written with their current partner.
    function validOwnCheckin(churchId, checkinId) {
      let d = request.resource.data;
      return request.auth != null
        && isActiveMember(churchId, request.auth.uid)
        && d.keys().hasOnly(['uid', 'name', 'weekKey', 'partnerUid', 'prayerScore', 'bibleDays',
          'temptation', 'win', 'struggle', 'prayerRequest', 'createdAt', 'updatedAt',
          'partnerReply', 'partnerPrayedAt'])
        && d.uid == request.auth.uid
        && d.weekKey is string && d.weekKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && checkinId == d.weekKey + '_' + request.auth.uid
        && d.get('partnerUid', null) == get(memberPath(churchId, request.auth.uid)).data.get('partnerUid', null)
        && validText(d.name, 1, 100)
        && d.prayerScore is int && d.prayerScore >= 1 && d.prayerScore <= 5
        && d.bibleDays is int && d.bibleDays >= 0 && d.bibleDays <= 7
        && d.temptation in ['no', 'yes', 'skip']
        && validText(d.win, 0, 1000)
        && validText(d.struggle, 0, 1000)
        && validText(d.prayerRequest, 0, 1000);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /churches/{churchId} {
      // The directory holds only public details, so any signed-in user may browse it.
      allow read: if request.auth != null;
      // Churches are created and edited by the national admin (approval flow).
      // An AG Leader or Assistant Leader (rank 5+) of an existing AG may also
      // start a new AG directly, becoming its AG Leader (see members below).
      allow create: if isAdmin()
        || (isRealAccount()
          && request.resource.data.keys().hasOnly(['name', 'pastorName', 'city', 'province', 'country',
            'denomination', 'website', 'status', 'createdAt', 'createdBy', 'createdFrom'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'active'
          && validText(request.resource.data.name, 2, 100)
          && validText(request.resource.data.pastorName, 1, 100)
          && validText(request.resource.data.city, 1, 80)
          && validText(request.resource.data.province, 0, 80)
          && validText(request.resource.data.country, 2, 80)
          && validText(request.resource.data.denomination, 0, 100)
          && validText(request.resource.data.website, 0, 200)
          && request.resource.data.createdAt is int
          && request.resource.data.createdFrom is string
          && rankAtLeast(request.resource.data.createdFrom, 5));
      allow update: if isAdmin();
      allow delete: if false;

      match /members/{uid} {
        allow read: if isAdmin()
          || (request.auth != null && request.auth.uid == uid)
          || rankAtLeast(churchId, 3)
          || (request.auth != null && resource.data.get('mentorUid', null) == request.auth.uid);

        // Join request: yourself, as a pending member, into an active church.
        allow create: if isAdmin()
          // The founder of a new AG becomes its AG Leader, in the same batch
          // that creates the AG.
          || (isRealAccount() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/churches/$(churchId))
            && getAfter(/databases/$(database)/documents/churches/$(churchId)).data.createdBy == uid
            && request.resource.data.keys().hasOnly(['uid', 'displayName', 'role', 'rank', 'status', 'joinedAt'])
            && request.resource.data.uid == uid
            && request.resource.data.role == 'senior_pastor'
            && request.resource.data.rank == 6
            && request.resource.data.status == 'active')
          || (isRealAccount() && request.auth.uid == uid
            && get(/databases/$(database)/documents/churches/$(churchId)).data.status == 'active'
            && request.resource.data.keys().hasOnly(['uid', 'displayName', 'role', 'rank', 'status', 'joinedAt'])
            && request.resource.data.uid == uid
            && request.resource.data.role == 'member'
            && request.resource.data.rank == 1
            && request.resource.data.status == 'pending');

        allow update: if isAdmin()
          // Members may update their display name, their sharing choice, and
          // (only while sharing) a summary of their journey progress.
          || (request.auth != null && request.auth.uid == uid
            && changedOnly(['displayName', 'shareProgress', 'progress', 'phone'])
            && (!request.resource.data.keys().hasAny(['progress'])
              || (request.resource.data.shareProgress == true && request.resource.data.progress is map))
            // A mobile number the member chose to share with their leaders.
            && (!request.resource.data.keys().hasAny(['phone']) || validText(request.resource.data.phone, 7, 20)))
          // A member's own mentor confirms journey checkpoints.
          || (request.auth != null
            && resource.data.get('mentorUid', null) == request.auth.uid
            && isActiveMember(churchId, request.auth.uid)
            && changedOnly(['confirmedLevels'])
            && request.resource.data.confirmedLevels is map)
          // Cell leaders and up approve join requests.
          || (rankAtLeast(churchId, 3)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.approvedBy == request.auth.uid
            && changedOnly(['status', 'approvedBy', 'approvedAt']))
          // Ministry leaders and pastors change roles, only for people below
          // them and only to roles below them.
          || (rankAtLeast(churchId, 4)
            && uid != request.auth.uid
            && resource.data.rank < myRank(churchId)
            && request.resource.data.rank < myRank(churchId)
            && validRole(request.resource.data.role, request.resource.data.rank)
            && changedOnly(['role', 'rank']))
          // Ministry leaders and pastors assign (or clear) a mentor, who must be
          // a mentor or above in this church.
          || (rankAtLeast(churchId, 4)
            && changedOnly(['mentorUid', 'mentorName'])
            && (request.resource.data.get('mentorUid', null) == null
              || (isActiveMember(churchId, request.resource.data.mentorUid)
                && get(memberPath(churchId, request.resource.data.mentorUid)).data.rank >= 2)))
          // Leaders pair (or unpair) accountability partners within the group.
          || (rankAtLeast(churchId, 4)
            && changedOnly(['partnerUid', 'partnerName'])
            && (request.resource.data.get('partnerUid', null) == null
              || (request.resource.data.partnerUid != uid
                && isActiveMember(churchId, request.resource.data.partnerUid))));

        allow delete: if isAdmin()
          || (request.auth != null && request.auth.uid == uid)
          || (rankAtLeast(churchId, 3) && resource.data.status == 'pending')
          || (rankAtLeast(churchId, 4) && resource.data.rank < myRank(churchId));
      }

      // Weekly accountability check-ins. Only the member and their current
      // accountability partner (recorded when the check-in is written) can
      // read one; leaders see only the separate check-in marks below.
      match /checkins/{checkinId} {
        allow read: if request.auth != null
          && (resource.data.uid == request.auth.uid || resource.data.partnerUid == request.auth.uid);
        allow create: if validOwnCheckin(churchId, checkinId)
          && !request.resource.data.keys().hasAny(['partnerReply', 'partnerPrayedAt']);
        allow update: if (validOwnCheckin(churchId, checkinId)
            && resource.data.uid == request.auth.uid
            && request.resource.data.get('partnerReply', null) == resource.data.get('partnerReply', null)
            && request.resource.data.get('partnerPrayedAt', null) == resource.data.get('partnerPrayedAt', null))
          // The partner may answer with a short note and "I prayed for you".
          || (request.auth != null
            && resource.data.partnerUid == request.auth.uid
            && changedOnly(['partnerReply', 'partnerPrayedAt'])
            && validText(request.resource.data.get('partnerReply', ''), 0, 500));
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }

      // "Checked in this week" markers: no content, so leaders (and the
      // national dashboard) can see who checked in without reading anyone's answers.
      match /checkinMarks/{markId} {
        allow read: if isAdmin() || rankAtLeast(churchId, 3)
          || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create, update: if request.auth != null && isActiveMember(churchId, request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid', 'weekKey', 'at'])
          && request.resource.data.uid == request.auth.uid
          && markId == request.resource.data.weekKey + '_' + request.auth.uid;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }

      // Testimonies a member shared with their AG only (a copy of their private
      // testimony). Doc id is "{ownerUid}_{testimonyId}".
      match /testimonies/{docId} {
        allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
        allow create, update: if request.auth != null && isActiveMember(churchId, request.auth.uid)
          && request.resource.data.ownerUid == request.auth.uid
          && docId.matches(request.auth.uid + '_.*');
        // The owner can always take it down (even after leaving); leaders can remove it.
        allow delete: if (request.auth != null && docId.matches(request.auth.uid + '_.*'))
          || rankAtLeast(churchId, 3);
      }

      // "My Oikos" lists a member chose to share: first names and steps only.
      // Doc id is the member's uid.
      match /oikos/{uid} {
        allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && isActiveMember(churchId, uid)
          && request.resource.data.keys().hasOnly(['uid', 'memberName', 'people', 'updatedAt'])
          && request.resource.data.uid == uid
          && validText(request.resource.data.memberName, 1, 100)
          && request.resource.data.people is list
          && request.resource.data.people.size() <= 10
          && request.resource.data.updatedAt is int;
        // The owner can always take it down (even after leaving); leaders can remove it.
        allow delete: if (request.auth != null && request.auth.uid == uid) || rankAtLeast(churchId, 3);
      }

      // AG announcements: every active member reads them; leaders post, edit
      // and remove them (an author can always remove their own).
      match /announcements/{announcementId} {
        allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
        allow create: if rankAtLeast(churchId, 3)
          && request.resource.data.keys().hasOnly(['title', 'body', 'pinned', 'authorUid', 'authorName', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && validText(request.resource.data.title, 1, 100)
          && validText(request.resource.data.body, 1, 2000)
          && request.resource.data.pinned is bool
          && validText(request.resource.data.authorName, 1, 100)
          && request.resource.data.createdAt is int;
        allow update: if rankAtLeast(churchId, 3)
          && changedOnly(['title', 'body', 'pinned'])
          && validText(request.resource.data.title, 1, 100)
          && validText(request.resource.data.body, 1, 2000)
          && request.resource.data.pinned is bool;
        allow delete: if rankAtLeast(churchId, 3)
          || (request.auth != null && resource.data.authorUid == request.auth.uid);
      }

      // Sermon outlines with [[blanks]] that members fill in while listening.
      // Members' answers stay private under users/{uid}/sermonAnswers.
      match /sermons/{sermonId} {
        allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
        allow create, update: if rankAtLeast(churchId, 3)
          && request.resource.data.keys().hasOnly(['title', 'speaker', 'scripture', 'date', 'outline', 'createdBy', 'createdAt'])
          && validText(request.resource.data.title, 1, 120)
          && validText(request.resource.data.speaker, 0, 100)
          && validText(request.resource.data.scripture, 0, 100)
          && request.resource.data.date is string
          && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && validText(request.resource.data.outline, 1, 10000)
          && request.resource.data.createdBy is string
          && request.resource.data.createdAt is int;
        allow delete: if rankAtLeast(churchId, 3);
      }

      // A reading plan the whole AG reads together. Leaders choose it; each
      // member records their own days, and everyone in the AG can see who read.
      match /groupPlans/{groupPlanId} {
        allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
        allow create, update: if rankAtLeast(churchId, 3)
          && request.resource.data.keys().hasOnly(['planId', 'title', 'startDate', 'active', 'createdBy', 'createdAt'])
          && validText(request.resource.data.planId, 1, 60)
          && validText(request.resource.data.title, 1, 120)
          && request.resource.data.startDate is string
          && request.resource.data.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.active is bool
          && request.resource.data.createdBy is string
          && request.resource.data.createdAt is int;
        allow delete: if rankAtLeast(churchId, 3);

        match /progress/{uid} {
          allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
          allow create, update: if request.auth != null && request.auth.uid == uid
            && isActiveMember(churchId, uid)
            && request.resource.data.keys().hasOnly(['uid', 'name', 'days', 'updatedAt'])
            && request.resource.data.uid == uid
            && validText(request.resource.data.name, 1, 100)
            && request.resource.data.days is list
            && request.resource.data.days.size() <= 400
            && request.resource.data.updatedAt is int;
          allow delete: if (request.auth != null && request.auth.uid == uid) || rankAtLeast(churchId, 3);
        }
      }

      // Church meetings: every active member sees them; cell leaders and up manage them.
      match /meetings/{meetingId} {
        allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
        allow create, update: if rankAtLeast(churchId, 3)
          && request.resource.data.keys().hasOnly(['title', 'type', 'platform', 'link', 'location',
            'startsAt', 'durationMin', 'weekly', 'createdBy', 'createdAt'])
          && validText(request.resource.data.title, 1, 100)
          && request.resource.data.type in ['bible_study', 'prayer', 'discipleship', 'leadership', 'service', 'other']
          && request.resource.data.platform in ['Google Meet', 'Teams', 'Zoom', 'In person']
          && validText(request.resource.data.link, 0, 500)
          && validText(request.resource.data.location, 0, 200)
          && request.resource.data.startsAt is int
          && request.resource.data.durationMin is int
          && request.resource.data.durationMin >= 5 && request.resource.data.durationMin <= 600
          && request.resource.data.weekly is bool;
        allow delete: if rankAtLeast(churchId, 3);

        // Attendance per occurrence: doc id is "{YYYY-MM-DD}_{uid}". Members
        // check themselves in; leaders see everyone and can correct the list.
        match /attendance/{attendanceId} {
          allow read: if rankAtLeast(churchId, 3)
            || (request.auth != null && attendanceId.matches('[0-9-]+_' + request.auth.uid));
          allow create: if request.auth != null && isActiveMember(churchId, request.auth.uid)
            && request.resource.data.keys().hasOnly(['uid', 'name', 'dateKey', 'at'])
            && request.resource.data.uid == request.auth.uid
            && attendanceId == request.resource.data.dateKey + '_' + request.auth.uid
            && request.resource.data.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && validText(request.resource.data.name, 1, 100);
          allow delete: if rankAtLeast(churchId, 3)
            || (request.auth != null && attendanceId.matches('[0-9-]+_' + request.auth.uid));
        }

        // RSVPs ("I'm coming" / "Can't make it") per occurrence: doc id is
        // "{YYYY-MM-DD}_{uid}". Everyone in the AG sees who is coming.
        match /rsvps/{rsvpId} {
          allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
          allow create, update: if request.auth != null && isActiveMember(churchId, request.auth.uid)
            && request.resource.data.keys().hasOnly(['uid', 'name', 'dateKey', 'going', 'at'])
            && request.resource.data.uid == request.auth.uid
            && rsvpId == request.resource.data.dateKey + '_' + request.auth.uid
            && request.resource.data.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && request.resource.data.going is bool
            && request.resource.data.at is int
            && validText(request.resource.data.name, 1, 100);
          allow delete: if rankAtLeast(churchId, 3)
            || (request.auth != null && rsvpId.matches('[0-9-]+_' + request.auth.uid));
        }
      }

      // Live study: the slide a leader is presenting right now. Members'
      // screens follow it; only the presenting leader moves it.
      match /live/{docId} {
        allow read: if isAdmin() || (request.auth != null && isActiveMember(churchId, request.auth.uid));
        allow create, update: if docId == 'current'
          && (isAdmin() || rankAtLeast(churchId, 3) || isAssignedPresenter(churchId, request.resource.data.get('assignmentId', '')))
          && request.resource.data.keys().hasOnly(['heading', 'parts', 'index', 'leaderUid', 'leaderName', 'assignmentId', 'callUrl', 'startedAt', 'updatedAt'])
          && (!request.resource.data.keys().hasAny(['callUrl'])
            || (request.resource.data.callUrl is string && request.resource.data.callUrl.size() <= 500 && request.resource.data.callUrl.matches('https://.+')))
          && request.resource.data.leaderUid == request.auth.uid
          && request.resource.data.heading is map
          && request.resource.data.parts is list
          && request.resource.data.parts.size() <= 40
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < request.resource.data.parts.size()
          && validText(request.resource.data.leaderName, 1, 100)
          && request.resource.data.startedAt is int
          && request.resource.data.updatedAt is int;
        allow delete: if isAdmin() || rankAtLeast(churchId, 3)
          || (request.auth != null && resource.data.leaderUid == request.auth.uid);
      }

      // One record per live study, kept after it ends, so leaders see attendance.
      // The id is the live study's startedAt; whoever presented it creates it.
      match /liveSessions/{sid} {
        allow read: if isAdmin() || rankAtLeast(churchId, 3);
        allow create: if request.auth != null
          && isActiveMember(churchId, request.auth.uid)
          && request.resource.data.keys().hasOnly(['heading', 'leaderUid', 'leaderName', 'startedAt'])
          && request.resource.data.leaderUid == request.auth.uid
          && request.resource.data.heading is map
          && validText(request.resource.data.leaderName, 1, 100)
          && request.resource.data.startedAt is int
          && sid == string(request.resource.data.startedAt)
          && get(/databases/$(database)/documents/churches/$(churchId)/live/current).data.leaderUid == request.auth.uid;
        allow delete: if isAdmin() || rankAtLeast(churchId, 3);

        // A member marks themselves present by joining the live study.
        match /attendees/{uid} {
          allow read: if isAdmin() || rankAtLeast(churchId, 3);
          allow create, update: if request.auth != null && request.auth.uid == uid
            && isActiveMember(churchId, uid)
            && exists(/databases/$(database)/documents/churches/$(churchId)/liveSessions/$(sid))
            && request.resource.data.keys().hasOnly(['uid', 'name', 'joinedAt'])
            && request.resource.data.uid == uid
            && validText(request.resource.data.name, 1, 100)
            && request.resource.data.joinedAt is int;
          allow delete: if isAdmin() || rankAtLeast(churchId, 3);
        }
      }

      // Courses the AG leader unlocked for the AG: every lesson in them opens.
      match /courseUnlocks/{courseId} {
        allow read: if isAdmin() || (request.auth != null && isActiveMember(churchId, request.auth.uid));
        allow create, update: if (isAdmin() || rankAtLeast(churchId, 3))
          && request.resource.data.keys().hasOnly(['courseId', 'unlockedBy', 'unlockedAt'])
          && request.resource.data.courseId == courseId
          && request.resource.data.unlockedBy == request.auth.uid
          && request.resource.data.unlockedAt is int;
        allow delete: if isAdmin() || rankAtLeast(churchId, 3);
      }

      // The member a leader asked to present (and exhort) a lesson ("{courseId}__{lessonId}").
      match /lessonAssignments/{aid} {
        allow read: if isAdmin() || (request.auth != null && isActiveMember(churchId, request.auth.uid));
        allow create, update: if (isAdmin() || rankAtLeast(churchId, 3))
          && request.resource.data.keys().hasOnly(['courseId', 'lessonId', 'presenterUid', 'presenterName', 'assignedBy', 'assignedAt'])
          && aid == request.resource.data.courseId + '__' + request.resource.data.lessonId
          && isActiveMember(churchId, request.resource.data.presenterUid)
          && validText(request.resource.data.presenterName, 1, 100)
          && request.resource.data.assignedAt is int;
        allow delete: if isAdmin() || rankAtLeast(churchId, 3);
      }

      // Prayer chains: leaders set a stretch of hours (up to a week, e.g. a
      // 24-hour prayer day during a fast); members sign up for hours. Slot
      // doc id is "{hour}_{uid}", and several people may share an hour.
      match /prayerChains/{chainId} {
        allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
        allow create, update: if rankAtLeast(churchId, 3)
          && request.resource.data.keys().hasOnly(['title', 'note', 'startsAt', 'hours', 'active', 'createdBy', 'createdAt'])
          && validText(request.resource.data.title, 1, 100)
          && validText(request.resource.data.note, 0, 500)
          && request.resource.data.startsAt is int
          && request.resource.data.hours is int
          && request.resource.data.hours >= 1 && request.resource.data.hours <= 168
          && request.resource.data.active is bool
          && request.resource.data.createdBy is string
          && request.resource.data.createdAt is int;
        allow delete: if rankAtLeast(churchId, 3);

        match /slots/{slotId} {
          allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
          allow create: if request.auth != null && isActiveMember(churchId, request.auth.uid)
            && request.resource.data.keys().hasOnly(['uid', 'name', 'hour', 'at'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.hour is int
            && request.resource.data.hour >= 0
            && request.resource.data.hour < get(/databases/$(database)/documents/churches/$(churchId)/prayerChains/$(chainId)).data.hours
            && slotId == string(request.resource.data.hour) + '_' + request.auth.uid
            && validText(request.resource.data.name, 1, 100)
            && request.resource.data.at is int;
          allow delete: if rankAtLeast(churchId, 3)
            || (request.auth != null && slotId.matches('[0-9]+_' + request.auth.uid));
        }
      }

      // Church prayer wall, for active members only. Anonymous requests store
      // no author at all, so nobody in the church can tell who posted them.
      match /prayers/{prayerId} {
        allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
        allow create: if request.auth != null && isActiveMember(churchId, request.auth.uid)
          && request.resource.data.keys().hasOnly(['text', 'category', 'anonymous', 'urgent',
            'authorUid', 'authorName', 'prayedCount', 'answered', 'createdAt'])
          && validText(request.resource.data.text, 1, 1000)
          && request.resource.data.category in ['health', 'family', 'finances', 'work',
            'salvation', 'spiritual', 'guidance', 'thanksgiving', 'other']
          && request.resource.data.urgent is bool
          && request.resource.data.prayedCount == 0
          && request.resource.data.answered == false
          && request.resource.data.createdAt is int
          && ((request.resource.data.anonymous == false
              && request.resource.data.authorUid == request.auth.uid
              && validText(request.resource.data.authorName, 1, 100))
            || (request.resource.data.anonymous == true
              && request.resource.data.authorUid == null
              && request.resource.data.authorName == null));
        allow update: if request.auth != null && isActiveMember(churchId, request.auth.uid)
          && (
            // "I prayed": +1 together with creating your prayedBy marker, -1 with removing it.
            (changedOnly(['prayedCount'])
              && ((request.resource.data.prayedCount == resource.data.prayedCount + 1
                  && !exists(/databases/$(database)/documents/churches/$(churchId)/prayers/$(prayerId)/prayedBy/$(request.auth.uid))
                  && existsAfter(/databases/$(database)/documents/churches/$(churchId)/prayers/$(prayerId)/prayedBy/$(request.auth.uid)))
                || (request.resource.data.prayedCount == resource.data.prayedCount - 1
                  && exists(/databases/$(database)/documents/churches/$(churchId)/prayers/$(prayerId)/prayedBy/$(request.auth.uid))
                  && !existsAfter(/databases/$(database)/documents/churches/$(churchId)/prayers/$(prayerId)/prayedBy/$(request.auth.uid)))))
            // The author marks their own request answered (or not).
            || (resource.data.authorUid == request.auth.uid
              && changedOnly(['answered'])
              && request.resource.data.answered is bool));
        allow delete: if (request.auth != null && resource.data.authorUid == request.auth.uid)
          || rankAtLeast(churchId, 3);

        match /prayedBy/{uid} {
          allow read: if request.auth != null && isActiveMember(churchId, request.auth.uid);
          allow create: if request.auth != null && request.auth.uid == uid
            && isActiveMember(churchId, uid)
            && getAfter(/databases/$(database)/documents/churches/$(churchId)/prayers/$(prayerId)).data.prayedCount
              == get(/databases/$(database)/documents/churches/$(churchId)/prayers/$(prayerId)).data.prayedCount + 1;
          allow delete: if request.auth != null && request.auth.uid == uid
            && getAfter(/databases/$(database)/documents/churches/$(churchId)/prayers/$(prayerId)).data.prayedCount
              == get(/databases/$(database)/documents/churches/$(churchId)/prayers/$(prayerId)).data.prayedCount - 1;
        }
      }
    }

    // ---------- Church registration ----------
    // One application per account (the doc id is the applicant's uid). The
    // national admin reviews it; approval creates the church in one batch.
    // Contact details stay here, readable only by the applicant and the admin.

    function validText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    match /churchApplications/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if isRealAccount() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['churchName', 'pastorName', 'city', 'province',
          'country', 'email', 'phone', 'website', 'denomination', 'memberCount', 'applicantName',
          'submittedBy', 'status', 'createdAt'])
        && request.resource.data.submittedBy == uid
        && request.resource.data.status == 'pending'
        && validText(request.resource.data.churchName, 2, 100)
        && validText(request.resource.data.pastorName, 2, 100)
        && validText(request.resource.data.city, 2, 80)
        && validText(request.resource.data.province, 2, 80)
        && validText(request.resource.data.country, 2, 80)
        && validText(request.resource.data.denomination, 2, 100)
        && validText(request.resource.data.applicantName, 1, 100)
        && validText(request.resource.data.website, 0, 200)
        && validText(request.resource.data.phone, 7, 30)
        && validText(request.resource.data.email, 5, 120)
        && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount >= 1
        && request.resource.data.memberCount <= 100000
        && request.resource.data.createdAt is int;
      // Only the admin reviews (approve / reject).
      allow update: if isAdmin();
      // Applicants may withdraw, or clear a rejected application to apply again.
      allow delete: if isAdmin()
        || (request.auth != null && request.auth.uid == uid && resource.data.status != 'approved');
    }

    // "Which church am I in?": a collection-group query for your own membership.
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Testimonies a member chose to share ("All members"). Any signed-in
    // member can read them; only the owner can publish, edit or unshare.
    match /communityTestimonies/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && docId.matches(request.auth.uid + '_.*');
      allow delete: if request.auth != null
        && docId.matches(request.auth.uid + '_.*');
    }
  }
}